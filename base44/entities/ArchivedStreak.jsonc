{
  "name": "ArchivedStreak",
  "type": "object",
  "properties": {
    "start_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the archived streak started"
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the streak ended (relapse date)"
    },
    "duration_days": {
      "type": "number",
      "description": "How many days the streak lasted"
    },
    "urges_resisted": {
      "type": "number",
      "description": "Total urges resisted during this streak"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes about this streak"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}