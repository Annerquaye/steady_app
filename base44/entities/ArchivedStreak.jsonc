{
  "name": "ArchivedStreak",
  "type": "object",
  "properties": {
    "start_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the archived streak started"
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the streak ended (relapse date)"
    },
    "duration_days": {
      "type": "number",
      "description": "How many days the streak lasted"
    },
    "urges_resisted": {
      "type": "number",
      "description": "Total urges resisted during this streak"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}