{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "target_habit": {
      "type": "string"
    },
    "reason_for_quitting": {
      "type": "string"
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vulnerable_times": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accountability_partner_email": {
      "type": "string"
    },
    "accountability_partner_name": {
      "type": "string"
    },
    "partners": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      }
    },
    "privacy_level": {
      "type": "string",
      "enum": [
        "minimal",
        "moderate",
        "full"
      ],
      "default": "minimal"
    },
    "send_weekly_email": {
      "type": "boolean",
      "default": false
    },
    "send_relapse_alert": {
      "type": "boolean",
      "default": false
    },
    "send_missed_checkin_alert": {
      "type": "boolean",
      "default": false
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "streak_start_date": {
      "type": "string",
      "format": "date-time"
    },
    "total_urges_resisted": {
      "type": "number",
      "default": 0
    },
    "total_relapses": {
      "type": "number",
      "default": 0
    },
    "recovery_plan": {
      "type": "string"
    },
    "recovery_plan_updated": {
      "type": "string",
      "format": "date-time"
    },
    "blocked_websites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "high_risk_apps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lockdown_windows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "days": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "hard_mode_enabled": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "daily_reminder_enabled": {
      "type": "boolean",
      "default": true
    },
    "milestone_notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "push_notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "daily_reminder_time": {
      "type": "string",
      "default": "20:00"
    },
    "notification_timezone": {
      "type": "string",
      "default": "America/New_York"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}